# =============================================================================
# Required — provided by Tonic.ai
# =============================================================================

# Quay.io credentials for pulling Fabricate Docker images
QUAY_IO_USER=
QUAY_IO_PASSWORD=

# Fabricate license key
FABRICATE_LICENSE=

# Anthropic API key (required to use Fabricate's AI features)
ANTHROPIC_API_KEY=

# =============================================================================
# Optional — uncomment and change to override defaults
# =============================================================================

# Name tag applied to the EC2 instance, key pair, security group, and state file
# (default: fabricate)
# INSTANCE_NAME=fabricate

# EC2 instance type — 8 GB RAM minimum recommended
# (default: t3.large)
# INSTANCE_TYPE=t3.large

# AWS region to deploy into — also passed to the Fabricate container
# (default: us-east-1)
# AWS_REGION=us-east-1

# Email address for the initial Fabricate admin account
# (default: admin@fabricate.local)
# ADMIN_EMAIL=admin@fabricate.local

# Root EBS volume size in GB
# (default: 40)
# DISK_SIZE_GB=40

# Pre-set a VPC ID to skip the interactive selection prompt
# (default: prompts you to choose)
# VPC_ID=
